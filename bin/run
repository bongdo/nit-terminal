#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -d web/node_modules ]; then
  npm --prefix web install --no-audit --no-fund
fi
if [ ! -f web/dist/index.html ] || [ -n "$(find web/src web/index.html web/package.json web/package-lock.json web/tsconfig.json web/vite.config.ts web/vitest.config.ts -newer web/dist/index.html -print -quit 2>/dev/null)" ]; then
  npm --prefix web run build
fi

if [ -z "${NIT_GATE_PASSWORD_HASH:-}" ] && [ -z "${NIT_GUI_PASSWORD_HASH:-}" ]; then
  export TERM_GUI_INSECURE=1
fi

exec go run . "$@"
